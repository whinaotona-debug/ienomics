rules_version = '2';

// イエノミクスのセキュリティルール
//
// 考え方:
//   ログインしていれば、存在する同期ID（families）にひもづくデータを読み書きできる。
//   一覧での総なめは禁止。同期IDを知っている端末向け。
//
// デプロイ:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyExists(code) {
      return code is string && exists(/databases/$(database)/documents/families/$(code));
    }

    // ログイン済みで、実在する同期IDならOK
    function canUseFamily(code) {
      return signedIn() && familyExists(code);
    }

    // ---- 利用者プロフィール ----
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- 家族（口座）----
    match /families/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.parentUid == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.parentUid == request.auth.uid
                    && request.resource.data.points == 0;

      // ログインしていれば更新可（お願い・ポイントなど）
      allow update: if signedIn();

      allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;
    }

    // ---- 同期IDにひもづく共有データ ----
    function canReadDoc() {
      return canUseFamily(resource.data.familyCode);
    }
    function canCreateDoc() {
      return canUseFamily(request.resource.data.familyCode);
    }
    function canModifyDoc() {
      return canUseFamily(resource.data.familyCode)
             && request.resource.data.familyCode == resource.data.familyCode;
    }

    match /tasks/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /taskTemplates/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /tickets/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /wishes/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /exchanges/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /investments/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /investmentLogs/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /banks/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /balloons/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /scheduledPayments/{docId} {
      allow read: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /paymentLogs/{docId} {
      // 未作成ドキュメントの get も許可する（引落前の有無確認用）。
      // 無いと resource.data 参照で permission-denied になり、新規引落が全部失敗する。
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/paymentLogs/$(docId))
        || canUseFamily(resource.data.familyCode)
      );
      allow list: if canReadDoc();
      allow create: if canCreateDoc();
      allow update: if canModifyDoc();
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /pushTokens/{deviceId} {
      allow get: if canReadDoc();
      allow list: if false;
      allow create: if canCreateDoc()
                    && request.resource.data.token is string
                    && request.resource.data.role in ['parent', 'child'];
      allow update: if canModifyDoc()
                    && request.resource.data.token is string;
      allow delete: if canUseFamily(resource.data.familyCode);
    }

    match /blastLobby/{id} {
      allow read, write: if signedIn();
    }
    match /blastRooms/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.size in [2, 3, 4]
                    && request.resource.data.status == 'wait'
                    && request.resource.data.players.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn() && (
                      request.auth.uid in resource.data.players
                      || (
                        resource.data.status == 'wait'
                        && request.auth.uid in request.resource.data.players
                        && request.resource.data.size == resource.data.size
                      )
                      || (
                        resource.data.status == 'play'
                        && request.resource.data.status == 'wait'
                        && request.resource.data.size == resource.data.size
                        && request.auth.uid in request.resource.data.players
                        && resource.data.endAt is int
                        && request.time.toMillis() > resource.data.endAt
                      )
                    );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
